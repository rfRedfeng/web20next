---
import AgentHandoff from '../components/AgentHandoff.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { messages, localizedPath, type Locale } from '../i18n';
import { publicSite } from '../lib/site-url';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = messages(locale);
const prompt = t.agentPrompt.replace('{site}', publicSite);
---
<SiteLayout locale={locale} page="join" title={t.contributeTitle} description={t.contributeDescription}>
  <article class="contribution-page agent-handoff section">
    <header class="agent-handoff-intro">
      <h1>{t.contributeLine1}<br />{t.contributeLine2}</h1>
      <p class="contribution-lead">{t.contributeIntro}</p>
      <p class="agent-explanation"><a href={localizedPath(locale, 'how-it-works')}>{t.howItWorks}</a></p>
    </header>
    <AgentHandoff locale={locale} id="agent-guide" prompt={prompt} />
    <div class="agent-handoff-notes">
      <p class="agent-ownership">{t.agentOutro}</p>
      <div class="agent-handoff-links"><a href={localizedPath(locale, 'manifesto')}>{t.startManifesto}</a><a href={localizedPath(locale, 'websites')}>{t.explore}</a></div>
    </div>
  </article>
</SiteLayout>
